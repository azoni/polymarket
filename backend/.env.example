# Polymarket Trading Bot Configuration
# Copy to .env and fill in your values

# === Required for live trading ===
POLY_PRIVATE_KEY=           # Your Polygon wallet private key (0x...)

# === Optional: pre-derived CLOB API credentials ===
# If not set, they'll be derived from your private key on connect
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === Optional: proxy wallet ===
POLY_FUNDER=                # Funder address if using a proxy wallet

# === Risk limits ===
POLY_MAX_POSITION=50        # Max $ per single position
POLY_MAX_DAILY_LOSS=25      # Stop trading if daily loss exceeds this
POLY_MAX_OPEN_ORDERS=5      # Max concurrent positions
POLY_MAX_EXPOSURE=200       # Max $ across all positions

# === Strategy thresholds ===
POLY_MIN_CONFIDENCE=70      # Min edge confidence score (0-100)
POLY_MIN_RETURN=3           # Min expected return %
POLY_MIN_LIQUIDITY=5000     # Skip markets with < this $ liquidity

# === Bot behavior ===
POLY_DRY_RUN=true           # Set to 'false' for live trading
POLY_SCAN_INTERVAL=120      # Seconds between market scans
POLY_LOG_LEVEL=INFO         # DEBUG for verbose output
